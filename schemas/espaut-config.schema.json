{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cepraea:esp-aut-git-001:espaut-config:0.1.0",
  "title": "ESP-AUT — Configuração local",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger_mode",
    "preservation_events",
    "eligible_patterns",
    "ai_enabled",
    "auto_commit",
    "resolver_roles",
    "merge_policy",
    "correction_max_attempts",
    "retention_policy",
    "ci_required"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trigger_mode": {
      "type": "string",
      "enum": [
        "explicit",
        "hook",
        "watch",
        "session"
      ]
    },
    "preservation_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligible_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_enabled": {
      "type": "boolean"
    },
    "auto_commit": {
      "type": "boolean"
    },
    "resolver_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "merge_policy": {
      "type": "string",
      "enum": [
        "manual",
        "semi_auto",
        "auto"
      ]
    },
    "correction_max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "retention_policy": {
      "type": "string",
      "enum": [
        "retain_all",
        "retain_recent",
        "archive"
      ]
    },
    "ci_required": {
      "type": "boolean"
    },
    "correction_test_command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ai_sharing_authorized": {
      "type": "boolean",
      "description": "Explicit permission to transmit authorized work to a connected external AI assistant; default false"
    }
  }
}
